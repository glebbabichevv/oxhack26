GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PRESAGE_API_KEY=
TIGER_DATA_URL=
VULTR_API_KEY=
# For gstack /design-shotgun image generation (optional)
OPENAI_API_KEY=
# Polymarket betting (integrations/polymarket_trading.py). Paper mode unless POLYMARKET_LIVE=1.
POLYMARKET_LIVE=0
POLYMARKET_PRIVATE_KEY=
# 0 = plain wallet (EOA), 1 = Polymarket email/Magic login, 2 = browser-wallet proxy
POLYMARKET_SIGNATURE_TYPE=0
# Your Polymarket proxy address (the one shown on polymarket.com) when signature type is 1 or 2
POLYMARKET_FUNDER=
POLYMARKET_MAX_BET_USD=25

# Invest dashboard (backend/invest_router.py)
DASHBOARD_PIN=
# Run the 10-minute trading loop in this process (only on the always-on host, never on Vercel)
TRADER_ENABLED=0
# Cap on open stake across all plans, in USD
MAX_TOTAL_EXPOSURE_USD=200
# Where plans.json / orders.json / equity.json live (default data/raw)
INVEST_DATA_DIR=
